<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_PedidoSaga"
                  targetNamespace="http://nexusflow/bpmn"
                  exporter="NexusFlow"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.8.0">

  <bpmn:error id="Error_EstoqueInsuficiente" name="Estoque insuficiente" errorCode="ESTOQUE_INSUFICIENTE" />
  <bpmn:error id="Error_PagamentoRecusado" name="Pagamento recusado" errorCode="PAGAMENTO_RECUSADO" />
  <bpmn:message id="Message_EntregaConfirmada" name="entrega-confirmada">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=pedidoId" />
    </bpmn:extensionElements>
  </bpmn:message>

  <bpmn:process id="pedido-saga" name="Saga de pedido" isExecutable="true">

    <bpmn:startEvent id="Start_PedidoRecebido" name="Pedido recebido">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 1. registra o pedido e calcula o total -->
    <bpmn:serviceTask id="Task_RegistrarPedido" name="Registrar pedido">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order.create" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- 2. reserva estoque; falta de estoque é erro de negócio; a compensação libera a reserva -->
    <bpmn:serviceTask id="Task_ReservarEstoque" name="Reservar estoque">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="inventory.reserve" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_EstoqueInsuficiente" name="Estoque insuficiente" attachedToRef="Task_ReservarEstoque">
      <bpmn:extensionElements>
        <!-- variáveis do erro BPMN ficam no escopo do evento: este mapping as leva para o processo -->
        <zeebe:ioMapping>
          <zeebe:output source="=motivoRejeicao" target="motivoRejeicao" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Rej_Estoque</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_Estoque" errorRef="Error_EstoqueInsuficiente" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_CompensarEstoque" attachedToRef="Task_ReservarEstoque">
      <bpmn:compensateEventDefinition id="CompDef_Estoque" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_LiberarEstoque" name="Liberar estoque" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="inventory.release" retries="5" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- 3. pedidos acima de R$ 1000 passam por aprovação humana -->
    <bpmn:exclusiveGateway id="Gateway_PrecisaAprovacao" name="Precisa de aprovação?" default="Flow_SemAprovacao">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_SemAprovacao</bpmn:outgoing>
      <bpmn:outgoing>Flow_ComAprovacao</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AprovarPedido" name="Aprovar pedido">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="financeiro" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ComAprovacao</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Aprovado" name="Aprovado?" default="Flow_Reprovado">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_Aprovado</bpmn:outgoing>
      <bpmn:outgoing>Flow_Reprovado</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_SeguirPagamento">
      <bpmn:incoming>Flow_SemAprovacao</bpmn:incoming>
      <bpmn:incoming>Flow_Aprovado</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- 4. cobra; recusa é erro de negócio; a compensação estorna -->
    <bpmn:serviceTask id="Task_CobrarPagamento" name="Cobrar pagamento">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment.charge" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="retryBackoff" value="5s" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_PagamentoRecusado" name="Pagamento recusado" attachedToRef="Task_CobrarPagamento">
      <bpmn:extensionElements>
        <!-- variáveis do erro BPMN ficam no escopo do evento: este mapping as leva para o processo -->
        <zeebe:ioMapping>
          <zeebe:output source="=motivoRejeicao" target="motivoRejeicao" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Rej_Pagamento</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_Pagamento" errorRef="Error_PagamentoRecusado" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_CompensarPagamento" attachedToRef="Task_CobrarPagamento">
      <bpmn:compensateEventDefinition id="CompDef_Pagamento" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_EstornarPagamento" name="Estornar pagamento" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment.refund" retries="5" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- 5. espera a mensagem de entrega; se o prazo vencer, desfaz tudo -->
    <bpmn:receiveTask id="Task_AguardarEntrega" name="Aguardar confirmação de entrega" messageRef="Message_EntregaConfirmada">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="Boundary_PrazoEntrega" name="Prazo de entrega vencido" attachedToRef="Task_AguardarEntrega">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;prazo de entrega vencido&#34;" target="motivoRejeicao" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Rej_Prazo</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Prazo">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=prazoEntrega</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="Task_ConcluirPedido" name="Concluir pedido">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order.complete" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_PedidoConcluido" name="Pedido concluído">
      <bpmn:incoming>Flow_08</bpmn:incoming>
    </bpmn:endEvent>

    <!-- caminho de rejeição: desfaz o que foi feito (compensação) e rejeita o pedido -->
    <bpmn:exclusiveGateway id="Gateway_Rejeitar">
      <bpmn:incoming>Flow_Rej_Estoque</bpmn:incoming>
      <bpmn:incoming>Flow_Reprovado</bpmn:incoming>
      <bpmn:incoming>Flow_Rej_Pagamento</bpmn:incoming>
      <bpmn:incoming>Flow_Rej_Prazo</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Event_Compensar" name="Desfazer operações">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CompDef_Throw" />
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="Task_RejeitarPedido" name="Rejeitar pedido">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order.reject" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_PedidoRejeitado" name="Pedido rejeitado">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_PedidoRecebido" targetRef="Task_RegistrarPedido" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_RegistrarPedido" targetRef="Task_ReservarEstoque" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ReservarEstoque" targetRef="Gateway_PrecisaAprovacao" />
    <bpmn:sequenceFlow id="Flow_SemAprovacao" name="até R$ 1000" sourceRef="Gateway_PrecisaAprovacao" targetRef="Gateway_SeguirPagamento" />
    <bpmn:sequenceFlow id="Flow_ComAprovacao" name="acima de R$ 1000" sourceRef="Gateway_PrecisaAprovacao" targetRef="Task_AprovarPedido">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=total &gt; 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_AprovarPedido" targetRef="Gateway_Aprovado" />
    <bpmn:sequenceFlow id="Flow_Aprovado" name="sim" sourceRef="Gateway_Aprovado" targetRef="Gateway_SeguirPagamento">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=aprovado = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reprovado" name="não" sourceRef="Gateway_Aprovado" targetRef="Gateway_Rejeitar" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_SeguirPagamento" targetRef="Task_CobrarPagamento" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_CobrarPagamento" targetRef="Task_AguardarEntrega" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_AguardarEntrega" targetRef="Task_ConcluirPedido" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_ConcluirPedido" targetRef="End_PedidoConcluido" />
    <bpmn:sequenceFlow id="Flow_Rej_Estoque" sourceRef="Boundary_EstoqueInsuficiente" targetRef="Gateway_Rejeitar" />
    <bpmn:sequenceFlow id="Flow_Rej_Pagamento" sourceRef="Boundary_PagamentoRecusado" targetRef="Gateway_Rejeitar" />
    <bpmn:sequenceFlow id="Flow_Rej_Prazo" sourceRef="Boundary_PrazoEntrega" targetRef="Gateway_Rejeitar" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_Rejeitar" targetRef="Event_Compensar" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Event_Compensar" targetRef="Task_RejeitarPedido" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_RejeitarPedido" targetRef="End_PedidoRejeitado" />

    <bpmn:association id="Assoc_LiberarEstoque" associationDirection="One" sourceRef="Boundary_CompensarEstoque" targetRef="Task_LiberarEstoque" />
    <bpmn:association id="Assoc_EstornarPagamento" associationDirection="One" sourceRef="Boundary_CompensarPagamento" targetRef="Task_EstornarPagamento" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_PedidoSaga">
    <bpmndi:BPMNPlane id="Plane_PedidoSaga" bpmnElement="pedido-saga">
      <!-- linha principal (y=240) -->
      <bpmndi:BPMNShape id="Start_PedidoRecebido_di" bpmnElement="Start_PedidoRecebido"><dc:Bounds x="152" y="222" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RegistrarPedido_di" bpmnElement="Task_RegistrarPedido"><dc:Bounds x="240" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReservarEstoque_di" bpmnElement="Task_ReservarEstoque"><dc:Bounds x="390" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PrecisaAprovacao_di" bpmnElement="Gateway_PrecisaAprovacao" isMarkerVisible="true"><dc:Bounds x="545" y="215" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SeguirPagamento_di" bpmnElement="Gateway_SeguirPagamento" isMarkerVisible="true"><dc:Bounds x="895" y="215" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CobrarPagamento_di" bpmnElement="Task_CobrarPagamento"><dc:Bounds x="990" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AguardarEntrega_di" bpmnElement="Task_AguardarEntrega"><dc:Bounds x="1140" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConcluirPedido_di" bpmnElement="Task_ConcluirPedido"><dc:Bounds x="1290" y="200" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_PedidoConcluido_di" bpmnElement="End_PedidoConcluido"><dc:Bounds x="1442" y="222" width="36" height="36" /></bpmndi:BPMNShape>

      <!-- aprovação (y=360) -->
      <bpmndi:BPMNShape id="Task_AprovarPedido_di" bpmnElement="Task_AprovarPedido"><dc:Bounds x="640" y="320" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Aprovado_di" bpmnElement="Gateway_Aprovado" isMarkerVisible="true"><dc:Bounds x="795" y="335" width="50" height="50" /></bpmndi:BPMNShape>

      <!-- compensações (abaixo das tarefas compensáveis) -->
      <bpmndi:BPMNShape id="Task_LiberarEstoque_di" bpmnElement="Task_LiberarEstoque"><dc:Bounds x="420" y="340" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EstornarPagamento_di" bpmnElement="Task_EstornarPagamento"><dc:Bounds x="1020" y="340" width="100" height="80" /></bpmndi:BPMNShape>

      <!-- boundary events -->
      <bpmndi:BPMNShape id="Boundary_EstoqueInsuficiente_di" bpmnElement="Boundary_EstoqueInsuficiente"><dc:Bounds x="392" y="262" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_CompensarEstoque_di" bpmnElement="Boundary_CompensarEstoque"><dc:Bounds x="452" y="262" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_PagamentoRecusado_di" bpmnElement="Boundary_PagamentoRecusado"><dc:Bounds x="992" y="262" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_CompensarPagamento_di" bpmnElement="Boundary_CompensarPagamento"><dc:Bounds x="1052" y="262" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_PrazoEntrega_di" bpmnElement="Boundary_PrazoEntrega"><dc:Bounds x="1172" y="262" width="36" height="36" /></bpmndi:BPMNShape>

      <!-- rejeição (y=600) -->
      <bpmndi:BPMNShape id="Gateway_Rejeitar_di" bpmnElement="Gateway_Rejeitar" isMarkerVisible="true"><dc:Bounds x="795" y="575" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Compensar_di" bpmnElement="Event_Compensar"><dc:Bounds x="1322" y="582" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RejeitarPedido_di" bpmnElement="Task_RejeitarPedido"><dc:Bounds x="1400" y="560" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_PedidoRejeitado_di" bpmnElement="End_PedidoRejeitado"><dc:Bounds x="1552" y="582" width="36" height="36" /></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="188" y="240" /><di:waypoint x="240" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="340" y="240" /><di:waypoint x="390" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="490" y="240" /><di:waypoint x="545" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SemAprovacao_di" bpmnElement="Flow_SemAprovacao"><di:waypoint x="595" y="240" /><di:waypoint x="895" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ComAprovacao_di" bpmnElement="Flow_ComAprovacao"><di:waypoint x="570" y="265" /><di:waypoint x="570" y="360" /><di:waypoint x="640" y="360" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="740" y="360" /><di:waypoint x="795" y="360" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Aprovado_di" bpmnElement="Flow_Aprovado"><di:waypoint x="845" y="360" /><di:waypoint x="920" y="360" /><di:waypoint x="920" y="265" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reprovado_di" bpmnElement="Flow_Reprovado"><di:waypoint x="820" y="385" /><di:waypoint x="820" y="575" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05"><di:waypoint x="945" y="240" /><di:waypoint x="990" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06"><di:waypoint x="1090" y="240" /><di:waypoint x="1140" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07"><di:waypoint x="1240" y="240" /><di:waypoint x="1290" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08"><di:waypoint x="1390" y="240" /><di:waypoint x="1442" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rej_Estoque_di" bpmnElement="Flow_Rej_Estoque"><di:waypoint x="410" y="298" /><di:waypoint x="410" y="600" /><di:waypoint x="795" y="600" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rej_Pagamento_di" bpmnElement="Flow_Rej_Pagamento"><di:waypoint x="1010" y="298" /><di:waypoint x="1010" y="660" /><di:waypoint x="820" y="660" /><di:waypoint x="820" y="625" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rej_Prazo_di" bpmnElement="Flow_Rej_Prazo"><di:waypoint x="1190" y="298" /><di:waypoint x="1190" y="680" /><di:waypoint x="830" y="680" /><di:waypoint x="830" y="621" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09"><di:waypoint x="845" y="600" /><di:waypoint x="1322" y="600" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1358" y="600" /><di:waypoint x="1400" y="600" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1500" y="600" /><di:waypoint x="1552" y="600" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_LiberarEstoque_di" bpmnElement="Assoc_LiberarEstoque"><di:waypoint x="470" y="298" /><di:waypoint x="470" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_EstornarPagamento_di" bpmnElement="Assoc_EstornarPagamento"><di:waypoint x="1070" y="298" /><di:waypoint x="1070" y="340" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
