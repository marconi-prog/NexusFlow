# ---------- Aplicação ----------
APP_ENV=development            # production exige API_KEYS
LOG_LEVEL=info                 # debug | info | warn | error
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=          # ex.: https://painel.empresa.com (ou *)

# Chaves de API: "chave:papel[:nome]" separadas por vírgula (chave >= 16 caracteres)
# Papéis: viewer (leitura), operator (+ executar/operar), admin (+ deploy)
API_KEYS=troque-esta-chave-admin-000:admin:plataforma,troque-esta-chave-erp-0000:operator:erp

# ---------- Camunda 8 (Orchestration Cluster REST API v2) ----------
# Self-managed: http://<gateway>:8080   |   SaaS: https://<region>.zeebe.camunda.io/<clusterId>
CAMUNDA_REST_ADDRESS=http://localhost:8088
CAMUNDA_AUTH_MODE=none         # none | basic | oauth
CAMUNDA_USERNAME=
CAMUNDA_PASSWORD=
CAMUNDA_OAUTH_URL=             # SaaS: https://login.cloud.camunda.io/oauth/token
CAMUNDA_CLIENT_ID=
CAMUNDA_CLIENT_SECRET=
CAMUNDA_TOKEN_AUDIENCE=zeebe.camunda.io
CAMUNDA_TOKEN_SCOPE=
CAMUNDA_TENANT_ID=             # multi-tenancy (opcional)
CAMUNDA_REQUEST_TIMEOUT=30s

# ---------- PostgreSQL (auditoria, idempotência, business keys) ----------
# Vazio => memória (só desenvolvimento; api e worker não compartilham eventos)
DATABASE_URL=postgres://nexusflow:nexusflow@localhost:5432/nexusflow?sslmode=disable
DATABASE_MAX_CONNS=10

# ---------- Monitoramento ----------
MONITOR_INCIDENT_POLL_INTERVAL=30s   # 0 desabilita (deixe ativo em só uma réplica da API)
EVENT_RETENTION=720h
IDEMPOTENCY_RETENTION=24h

# ---------- Worker ----------
WORKER_NAME=                   # padrão: hostname
WORKER_JOB_TYPES=              # vazio => todos os handlers registrados
WORKER_CONCURRENCY=16          # jobs simultâneos por tipo
WORKER_MAX_JOBS=32             # jobs por ativação
WORKER_JOB_TIMEOUT=5m          # lock do job no motor
WORKER_POLL_INTERVAL=1s
WORKER_REQUEST_TIMEOUT=20s     # long polling
WORKER_SHUTDOWN_GRACE=30s
WORKER_METRICS_PORT=9091
WORKER_HTTP_ALLOWED_HOSTS=     # allowlist do nexusflow.http: api.empresa.com,.interno.empresa.com (* libera tudo)
